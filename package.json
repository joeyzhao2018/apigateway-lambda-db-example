    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-cdk/aws-apigateway": "^1.203.0",
    "@aws-cdk/aws-ec2": "^1.203.0",
    "@aws-cdk/aws-elasticache": "^1.203.0",
    "@aws-cdk/aws-lambda": "^1.203.0",
    "@aws-cdk/aws-rds": "^1.203.0",
    "aws-cdk-lib": "2.181.1",
    "aws-sdk": "^2.1692.0",
    "constructs": "^10.0.0"
  }
