{
  "name": "my-lambda-api-db",
  "version": "0.1.0",
  "bin": {
    "my-lambda-api-db": "bin/my-lambda-api-db.js"
  },
  "scripts": {
    "build_lambda": "pushd lib/lambda && npm install && npm run build && popd",
